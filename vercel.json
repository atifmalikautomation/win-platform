{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://accompanied-residential-colored-witnesses.trycloudflare.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://accompanied-residential-colored-witnesses.trycloudflare.com/socket.io/:path*"
    }
  ]
}
